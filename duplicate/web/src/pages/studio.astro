---
import Layout from '../layouts/Layout.astro';
const studio=import.meta.env.PUBLIC_SANITY_STUDIO_URL;
if(studio){const u=new URL(studio);if(u.protocol!=='https:'||u.username||u.password)throw new Error('Invalid Studio URL');}
---
<Layout title="Editorial studio | ATHENA" noindex><section class="login"><p class="eyebrow">ATHENA / EDITORIAL STUDIO</p><h1>Editor login</h1>{studio?<><p>Invited newsroom staff: sign in with the account used for your Sanity invitation. Reader accounts do not grant editorial access.</p><a class="black-button" href={studio}>Sign in to the newsroom</a></>:<p>The duplicate newsroom is being connected. The original newsroom remains available on the original website.</p>}</section></Layout>
